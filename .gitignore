# ==========================================
# Virtual Environment (สำคัญที่สุด)
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# Python Bytecode & Cache (ไฟล์ชั่วคราวจากการรัน)
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Secret Keys / Environment Variables (ความลับของโปรเจกต์)
# ==========================================
.env
.env.local
*.pem

# ==========================================
# IDE & Code Editor Settings (การตั้งค่าส่วนตัว)
# ==========================================
.vscode/
.idea/
*.swp

# ==========================================
# Testing & Coverage (ผลการทดสอบโค้ด)
# ==========================================
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Distribution / Packaging (ไฟล์ Build)
# ==========================================
build/
dist/
*.egg-info/
